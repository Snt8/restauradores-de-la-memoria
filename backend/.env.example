# Entorno: development | test | production
ENVIRONMENT=development

# Conexión a PostgreSQL (docker compose expone el puerto 5433 en el host).
DATABASE_URL=postgresql+asyncpg://restauradores:restauradores@localhost:5433/restauradores

# Base de datos exclusiva para las pruebas de integración.
TEST_DATABASE_URL=postgresql+asyncpg://restauradores:restauradores@localhost:5433/restauradores_test

# Orígenes permitidos por CORS (lista JSON).
CORS_ORIGINS=["http://localhost:5173"]

# Segundos máximos para comprobar la base de datos en /health/ready.
DB_HEALTH_TIMEOUT_SECONDS=2
